# =============================================================================
# Trinity Guard — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env
#
# All services read from this file via docker-compose env_file.
# =============================================================================

# ---- PostgreSQL ----
DATABASE_URL=postgres://marble_user:marble_password@postgres:5432/marble_trinity?sslmode=disable

# ---- Redis (NER caching + Go pub/sub) ----
REDIS_URL=redis://redis:6379

# ---- Service Endpoints (inter-service communication) ----
# Go backend calls these services
NER_ENDPOINT=http://python-ner:9000
LLM_ENDPOINT=http://llm-service:8080
ZK_ENDPOINT=http://rust-zk:50053

# ---- Service Ports (host mappings) ----
PORT_GO=8080
PORT_NER=9000
PORT_LLM=8080
PORT_ZK=50053

# ---- Python NER (GLINER) ----
GLINER_MODEL=urchade/gliner_base
GLINER_CACHE_DIR=/app/models
GLINER_LABELS=Person,Company,Country,Illegal Activity

# ---- LLM Service ----
# Provider: "ollama" (default, self-hosted) or "openai" (requires API key)
LLM_PROVIDER=ollama

# OpenAI settings (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ---- Rust ZK ----
RUST_LOG=info

# ---- Monitoring ----
GRAFANA_ADMIN_PASSWORD=trinity2026
PROMETHEUS_RETENTION=15d
